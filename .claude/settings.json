{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tools/rotate_lessons.sh\"",
            "timeout": 15,
            "statusMessage": "Rotating tentative-lesson buffers"
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/games/webdiplomacy/tools/check_clis.py\"",
            "timeout": 20,
            "statusMessage": "Checking coworld and softmax CLI versions"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/games/webdiplomacy/tools/check_coworld.py\"",
            "timeout": 40,
            "statusMessage": "Checking the webDiplomacy Coworld version and changelog"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/ide/ide\" hook SessionStart",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/ide/ide\" hook Rewake",
            "asyncRewake": true,
            "timeout": 604800
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tools/lessons_stop_nudge.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tools/experiments_stop_nudge.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/ide/ide\" hook Stop",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/ide/ide\" hook Rewake",
            "asyncRewake": true,
            "timeout": 604800
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/ide/ide\" hook UserPromptSubmit",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/ide/ide\" hook Rewake",
            "asyncRewake": true,
            "timeout": 604800
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/ide/ide\" hook PostToolUse",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/ide/ide\" hook Rewake",
            "asyncRewake": true,
            "timeout": 604800
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/ide/ide\" hook SessionEnd",
            "timeout": 10
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/ide/ide\" hook Rewake",
            "asyncRewake": true,
            "timeout": 604800
          }
        ]
      }
    ]
  }
}
